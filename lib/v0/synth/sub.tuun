open std;
use filters.rbj;
use env.minmax;
use env.finseq;
use env.expfil;

// An example of subtractive synthesis from Welsh's Synthesizer Cookbook
harmonica = fn(dur, freq) =>
  let
    // These are approximately Welsh's values but not exactly
    osc1 = pulse(0.93 + 0.05 * $(1.6), freq),
    osc2 = reset(osc1, pulse(0.7, add_cents(add_semitones(freq, 8), 7))),
    osc = 0.375 * osc1 + 0.5 * osc2,
    a = 0.13,
    r = 0.33,
    d = max(0.33, dur - (a + r)),
    s = max(dur - (a + d + r), 0),
  in
    osc
    | rbj.lpf(0.5, 1900)
    | minmax.ADSR(a + d + s + r, a, d, 0.5, r)
    | fin(time - dur) // redundant with the ADSR
    | seq(time - dur);


tuned_kick_drum = fn() => fn(dur, freq_hz) =>
  let
    lpf_cutoff = 300,
    Q = 0.707,
    freq_hz = freq_hz / 8, // Lower three octaves
    freq_env_mul = 4,
    freq_env_dur = 0.02,
    freq_env = max(linear(freq_env_mul, -1/freq_env_dur), 1)
  in
    (0.08 * noise | expfil.R(0.01, 1.0))
    &
    (1.1 * triangle(freq_hz * freq_env)
      | rbj.lpf(Q, lpf_cutoff)
      | expfil.R(0.2, 1.0))
      | seq(time - dur);

// Defaults to C
kick_drum = fn() => fn(dur) => tuned_kick_drum()(dur, @60);

_flute_osc = fn(freq_hz, lpf_Q = 0.6, lpf_cutoff = 1600, hpf_Q = 0.6, hpf_cutoff = 1600) =>
  sawtooth(freq_hz)
  | rbj.lpf2(lpf_Q, lpf_cutoff)
  | rbj.hpf(hpf_Q, hpf_cutoff);


flute = fn(dur, freq_hz, lpf_Q = 0.6, lpf_cutoff = 1600, hpf_Q = 0.6, hpf_cutoff = 1600) =>
  let
    attack_dur = 0.27,
    release_dur = 0.17,
  in
    _flute_osc(freq_hz, lpf_Q = lpf_Q, lpf_cutoff = lpf_cutoff, hpf_Q = hpf_Q)
    | minmax.ADSR(dur, attack_dur, 0.0, 1.0, release_dur);

flute_keys = fn(lpf_Q = 0.6, lpf_cutoff = 1600, hpf_Q = 0.6, hpf_cutoff = 1600) =>
  fn(k, v) =>
  let
    attack_dur = 0.27,
    release_dur = 0.17,
  in
    (_flute_osc(@k, lpf_Q = lpf_Q, lpf_cutoff = lpf_cutoff, hpf_Q = hpf_Q)
     | minmax.ADS(attack_dur, 0.0, 1.0),
    finseq.Rw(release_dur, 1.0));
