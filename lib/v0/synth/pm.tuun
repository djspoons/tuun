open std;
use env.minmax;
use env.finseq;

// A pure PM waveform. Note that any of I, D, or fc can control the length of the output.
pure = fn(I, D) => fn(freq_hz) =>
  let
    fm = D/2 * freq_hz
  in
    sine(2*pi * freq_hz, I * sine(2*pi * fm, 0));

// Given I_max, D, and envelope, returns an instrument
synth = fn(I_max, D, a, d, s_level, r) => fn(dur, freq_hz) =>
  let
    s = max(dur - (a + d + r), 0),
    envelope = minmax.ADSR(a, d, s_level, s, r),
    I = I_max | envelope,
    fm = D/2 * freq_hz
  in
    sine(2*pi * freq_hz, sine(2*pi * fm, 0) * I) | envelope;

// Roughly from Chowning (1977)
brass = synth(5, 1, 0.1, 0.1, 0.75, 0.1);

piano_keys = fn(k, v) =>
  let
    I1_max = 6,
    amp_attack = 0.01,
    amp_decay = 0.55,
    amp_sustain_level = 0.65,
    amp_release = 0.2,

    I2_max = 10,
    ratio2 = 2.98, // Slightly inharmonic
    attack2 = 0.01,
    decay2 = 0.33,
    sustain_level2 = 0.2,
    osc_mix = 0.73,

    fc = @k,
    // First stack: ratio of 1:1
    envelope1 = minmax.ADS(amp_attack, amp_decay, amp_sustain_level),
    I1 = I1_max | envelope1,
    osc1 = v * sine(2*pi * fc, I1 * sine(2*pi * fc, 0)) | envelope1,

    // Second stack
    envelope2 = minmax.ADS(attack2, decay2, sustain_level2),
    I2 = I2_max | envelope2,
    fc2 = fc * 1.01, // A little detune
    fm2 = ratio2 * fc2,
    // Non-linear response to key velocity for the second oscillator.
    osc2 = v * v * sine(2*pi * fc2, I2 * sine(2*pi * fm2, 0)) | envelope2,
    note_on = osc_mix * osc1 + (1 - osc_mix) * osc2,

    // Something better combination of the two envelopes?
    // This doesn't allow for I2 to change as part of the release
    note_off = finseq.Rw(amp_release, 1.0)
  in
    (note_on, note_off);

ukulele = fn(I_max, decay_dur, mod_decay_dur) => fn(dur, freq_hz) =>
  let
    //I_max = 10,
    attack_dur = 0.01,
    //decay_dur = 0.41,
    sustain_level = 0.17,
    sustain_dur = 0,
    release_dur = 2.0,
    mute_dur = 0.2,

    mod_envelope = minmax.ADSR(attack_dur, mod_decay_dur, sustain_level, sustain_dur, release_dur),

    I = I_max | mod_envelope,
    fc = freq_hz,
    osc = sine(2*pi * fc, I * sine(2*pi * fc, 0)),
    //pluck = noise * <[finseq.Rw(0.03, 1.0)]> | seq(time - 0.03),
    //mix = osc + (0.2 * pluck \ 0)

    envelope = minmax.ADSR(attack_dur, decay_dur, sustain_level, sustain_dur, release_dur),

  in
    osc | envelope | seq(time - dur) | fin(time - dur);


ukulele_keys = fn(I_max) => fn(k, v) =>
  let
    //I_max = 10,
    amp_attack = 0.01,
    amp_decay = 0.41,
    amp_sustain_level = 0.17,
    amp_release = 2.0,
    mute_dur = 0.2,

    fc = @k,
    envelope = minmax.ADS(amp_attack, amp_decay, amp_sustain_level),
    I = I_max | envelope,
    osc = v * sine(2*pi * fc, I * sine(2*pi * fc, 0)) | envelope,
    note_on = osc,

    note_off = finseq.Rw(mute_dur, 1.0)
  in
    (note_on, note_off);
