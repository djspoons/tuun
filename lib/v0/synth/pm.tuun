open std;
use env.minmax;
use env.finseq;

// A pure PM waveform. Note that any of I, D, or freq_hz can control the length
// of the output.
pure = fn(I, D, freq_hz) =>
  let
    w_c = 2 * pi * freq_hz,
    w_m = D/2 * w_c,
  in
    sine(w_c, I * sine(w_m, 0));

// Given I_max, D, and envelope, returns an instrument
synth = fn(I_max, D, a, d, s_level, r) => fn(dur, freq_hz) =>
  let
    envelope = minmax.ADSR(dur, a, d, s_level, r),
    I = I_max | envelope,
  in
    pure(I, D, freq_hz) | envelope | seq(time - dur);

// Given I_max, D, and envelope, returns part of an instrument or keys instrument
synth_stack = fn(I_max, D, a, d, s_level) =>
  let
    envelope = minmax.ADS(a, d, s_level),
    I = I_max | envelope,
  in
    fn(freq_hz) => pure(I, D, freq_hz) | envelope;

// Roughly from Chowning (1977)
(brass, brass_keys) = let
    I_max = 5,
    D = 1,
    attack_dur = 0.1,
    decay_dur = 0.1,
    sustain_level = 0.75,
    release_dur = 0.1,

    inst = synth(I_max, D, attack_dur, decay_dur, sustain_level, release_dur),
    keys = let
        stack = synth_stack(I_max, D, attack_dur, decay_dur, sustain_level),
        note_off = finseq.Rw(release_dur, 1.0),
      in
        fn(k, v) => (v * stack(@k), note_off),
  in
    (inst, keys);

(epiano, epiano_keys) = let
    I1_max = 6,
    amp_attack = 0.01,
    amp_decay = 0.55,
    amp_sustain_level = 0.65,
    amp_release = 0.2,
    D1 = 2,

    I2_max = 10,
    attack2 = 0.01,
    decay2 = 0.33,
    sustain_level2 = 0.2,
    release2 = 0.2,
    // Slightly inharmonic
    D2 = 5.96,

    mix = 0.73, // portion of mix from first stack

    inst = fn() => fn(dur, freq_hz) => let
        envelope1 = minmax.ADSR(dur, amp_attack, amp_decay, amp_sustain_level, amp_release),
        I1 = I1_max | envelope1,
        osc1 = pure(I1, D1, freq_hz) | envelope1,

        envelope2 = minmax.ADSR(dur, attack2, decay2, sustain_level2, release2),
        I2 = I2_max | envelope2,
        // A little detune
        osc2 = pure(I2, D2, freq_hz * 1.01) | envelope2,
      in
        mix * osc1 & ((1 - mix) * osc2) | seq(time - dur),

    // Something better combination of the two envelopes?
    // This doesn't allow for I2 to change as part of the release
    keys = fn() => fn(k, v) => let
        freq_hz = @k,
        envelope1 = minmax.ADS(amp_attack, amp_decay, amp_sustain_level),
        I1 = I1_max | envelope1,
        osc1 = v * pure(I1, D1, freq_hz) | envelope1,

        envelope2 = minmax.ADS(attack2, decay2, sustain_level2),
        I2 = I2_max | envelope2,
        // A little detune and non-linear response to key velocity for the
        // second oscillator.
        osc2 = v * v * pure(I2, D2, freq_hz * 1.01) | envelope2,
      in
        (mix * osc1 + (1 - mix) * osc2, finseq.Rw(amp_release, 1.0)),
  in
    (inst, keys);

ukulele = fn(I_max, decay_dur, mod_decay_dur) => fn(dur, freq_hz) =>
  let
    //I_max = 10,
    attack_dur = 0.01,
    //decay_dur = 0.41,
    sustain_level = 0.17,
    sustain_dur = 0,
    release_dur = 2.0,
    mute_dur = 0.2,

    mod_envelope = minmax.ADSR(attack_dur + mod_decay_dur + sustain_dur + release_dur, attack_dur, mod_decay_dur, sustain_level, release_dur),

    I = I_max | mod_envelope,
    f_c = freq_hz,
    osc = sine(2 * pi * f_c, I * sine(2 * pi * f_c, 0)),
    //pluck = noise * <[finseq.Rw(0.03, 1.0)]> | seq(time - 0.03),
    //mix = osc + (0.2 * pluck \ 0)

    envelope = minmax.ADSR(attack_dur + decay_dur + sustain_dur + release_dur, attack_dur, decay_dur, sustain_level, release_dur),

  in
    osc | envelope | seq(time - dur) | fin(time - dur);


ukulele_keys = fn(I_max) => fn(k, v) =>
  let
    //I_max = 10,
    amp_attack = 0.01,
    amp_decay = 0.41,
    amp_sustain_level = 0.17,
    amp_release = 2.0,
    mute_dur = 0.2,

    f_c = @k,
    envelope = minmax.ADS(amp_attack, amp_decay, amp_sustain_level),
    I = I_max | envelope,
    osc = v * sine(2 * pi * f_c, I * sine(2 * pi * f_c, 0)) | envelope,
    note_on = osc,

    note_off = finseq.Rw(mute_dur, 1.0)
  in
    (note_on, note_off);
