open std;

// Given a `tonic` MIDI note number, a mode, duration, and instrument, take a
// list of scale degree numbers and use the instrument to generate a sequence
// of waveforms. Modes are named by their degree, so 1 = Ionian, 2 = Dorian,
// etc. For example,
//    [1, 3, 5] | on_diatonic_scale(60, 2, Q, inst)
// will generate quarter notes for the D minor triad (the triad starting at root
// of the Dorian mode of the C major scale and continuing to the third and fifth
// notes of that scale). Half degrees will generate notes half a step from the 
// adjacent note when that note exists.
on_diatonic_scale = fn(tonic, mode, dur, inst) =>
  let
    // Given scale degree d, offset[(d-1) * 2] is the number of half steps above
    // the tonic. Notes on a C major scale are shown as an example.
    // degree  1  1.5 2  2.5 3     4  4.5 5  5.5 6  6.5 7
    //         C  C#  D  D#  E     F  F#  G  G#  A  A#  B
    offsets = [0, 1,  2, 3,  4, 0, 5, 6,  7, 8,  9, 10, 11, 0,
              12,13, 14,15, 16, 0,17,18, 19,20, 21, 22, 23, 0,
              24,25, 26,27, 28, 0,29,30, 31,32, 33, 34, 35, 0],
    _ = mode | debug("mode"),
    mode_offset = nth((mode-1) * 2, offsets) | debug("mode_offset"),
    // Determine the MIDI note number given the degree
    note = fn(degree) => tonic + nth(round((degree-1) * 2), offsets) + mode_offset,
  in
    fn(degrees) => let
      notes = map(note, degrees) | debug("notes"),
    in
      <map(fn(note) => inst(dur, @note), notes)>;

use synth.pm;

#{level_db=0,keys}
keys = pm.brass_keys;

// Fux's dorian first species cantus firmus
#{level_db=-9}
fux_dorian_c_f =                 [1, 3, 2, 1, 4, 3, 5, 4, 3, 2, 1] | on_diatonic_scale(60, 2, Q, pm.brass);

#{level_db=-9}
fux_dorian_c_p_upper =           [5, 5, 4, 5, 6, 7, 7, 6, 8, 7.5, 8] | on_diatonic_scale(60, 2, Q, pm.brass);

// Some variations on a counterpoint to Fux's dorian
#{level_db=-9}
dorian_c_p_upper_1 =             [8, 8, 7, 8, 9, 8, 7, 8, 8, 7.5, 8] | on_diatonic_scale(60, 2, Q, pm.brass);
#{level_db=-9}
dorian_c_p_upper_2 =             [8, 8, 7, 8, 6, 8, 7, 6, 8, 7.5, 8] | on_diatonic_scale(60, 2, Q, pm.brass);

#{level_db=-9}
fux_dorian_c_p_lower =           [4, 8, 5, 3, 2, 1, 3, 7, 8, 7.5, 8] | on_diatonic_scale(48, 2, Q, pm.brass);
#{level_db=-9}
fux_dorian_c_p_lower_corrected = [1, 1, 5, 3, 2, 1, 3, 7, 8, 7.5, 8] | on_diatonic_scale(48, 2, Q, pm.brass);

#{level_db=-9}
dorian_c_p_lower_1 =             [1, 1, 4, 3, 2, 3, 7, 7, 5, 7.5, 8] | on_diatonic_scale(48, 2, Q, pm.brass);

// Fux's lydian first species cantus firmus
#{level_db=-9}
// Written with a vocal tenor clef
fux_lydian_c_f       = [8, 9, 10, 8, 6, 7, 8, 12, 10, 8, 9, 8] | on_diatonic_scale(36, 4, Q, pm.brass);
#{level_db=-9}
fux_lydian_c_p_upper = [8, 7,  6, 8, 8, 9, 10,  9, 6, 8, 7, 8] | on_diatonic_scale(48, 4, Q, pm.brass);

// Some alternative counterpoints
#{level_db=-9}
lydian_c_p_upper_1 =   [12, 10.5, 12, 13, 13, 12, 12, 14, 12, 12, 14, 15] | on_diatonic_scale(36, 4, Q, pm.brass);


#{level_db=-9, skip_slots=5}
morley_c_f =   [1, 4, 3, 2, 1, 4, 5, 6, 5, 3, 2, 1] | on_diatonic_scale(60, 1, Q, pm.brass);
// This one is pretty boring
#{level_db=-9}
morley_c_p_1 = [5, 6, 5, 4, 5, 6, 7, 8, 7, 8, 7, 8] | on_diatonic_scale(60, 1, Q, pm.brass);
// This c.p. sort of jumps the gun on the c.f.'s high note
#{level_db=-9}
morley_c_p_2 = [8, 9, 8, 4, 5, 6, 10, 8, 7, 8, 7, 8] | on_diatonic_scale(60, 1, Q, pm.brass);
#{level_db=-9}
morley_c_p_2 = [8, 9, 8, 4, 5, 6, 7, 8, 10, 8, 7, 8] | on_diatonic_scale(60, 1, Q, pm.brass);


#{level_db=-9,skip_slots=4}
kirnberger_c_f = [1, 5, 3, 6, 5, 4, 3, 2, 1] | on_diatonic_scale(60, 1, Q, pm.brass);
#{level_db=-9}
kirnberger_c_p_1 = [8, 7, 7, 8, 9, 9, 8, 7, 8] | on_diatonic_scale(60, 1, Q, pm.brass);
#{level_db=-9}
kirnberger_c_p_2 = [8, 7, 7, 8, 9, 6, 7, 7, 8] | on_diatonic_scale(60, 1, Q, pm.brass);