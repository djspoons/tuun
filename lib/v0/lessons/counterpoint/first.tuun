open std;
use midi.notes;

// TODO figure out why this can't be typed when used
//as_midi_notes = fn(dur, inst) => fn(notes) => <map(fn(n) => inst(dur, @n), notes)>;

use synth.pm;

#{level_db=0,keys}
keys = pm.brass_keys;

brass_notes = fn(dur) => fn(notes) => <map(fn(n) => pm.brass(dur, @n), notes)>;

(C2, C#2, D2, D#2, E2, F2, F#2, G2, G#2, A2, A#2, B2) = notes.midi_octave(2);
(C, C#, D, D#, E, F, F#, G, G#, A, A#, B) = notes.midi_octave(4);
(C3, C#3, D3, D#3, E3, F3, F#3, G3, G#3, A3, A#3, B3) = notes.midi_octave(3);
(C5, C#5, D5, D#5, E5, F5, F#5, G5, G#5, A5, A#5, B5) = notes.midi_octave(5);

// Fux's dorian first species cantus firmus
#{level_db=-9}
fux_dorian_c_f =                 [D, F, E, D, G, F, A, G, F, E, D] | brass_notes(Q);

#{level_db=-9}
fux_dorian_c_p_upper =           [A, A, G, A, B, C5, C5, B, D5, C#5, D5] | brass_notes(Q);

// Some variations on a counterpoint to Fux's dorian
#{level_db=-9}
dorian_c_p_upper_1 =             [D5, D5, C5, D5, E5, D5, C5, D5, D5, C#5, D5] | brass_notes(Q);
#{level_db=-9}
dorian_c_p_upper_2 =             [D5, D5, C5, D5, B, D5, C5, B, D5, C#5, D5] | brass_notes(Q);

#{level_db=-9}
fux_dorian_c_p_lower =           [G3, D, A3, F3, E3, D3, F3, C, D, C#, D] | brass_notes(Q);
#{level_db=-9}
fux_dorian_c_p_lower_corrected = [D3, D3, A3, F3, E3, D3, F3, C, D, C#, D] | brass_notes(Q);

#{level_db=-9}
dorian_c_p_lower_1 =             [D3, D3, G3, F3, E3, F3, C, C, A3, C#, D] | brass_notes(Q);

// Fux's lydian first species cantus firmus
#{level_db=-9}
// Written with a vocal tenor clef
fux_lydian_c_f       = [F3, G3, A3, F3, D3, E3, F3, C, A3, F3, G3, F3] | brass_notes(Q);
#{level_db=-9}
fux_lydian_c_p_upper = [F, E, C, F, F, G, A, G, C, F, E, F] | brass_notes(Q);

// Some alternative counterpoints
#{level_db=-9}
lydian_c_p_upper_1 =   [C, A#3, C, D, D, C, C, E, C, C, E, F] | brass_notes(Q);
#{level_db=-9}
lydian_c_p_upper_2 = [F, E, C, D, F, E, A, G, F, A, E, F] | brass_notes(Q);

#{level_db=-9}
fux_lydian_c_p_lower = [F3, E3, F3, A3, A#3, G3, A3, E3, F3, D3, E3, F3] | brass_notes(Q);

// Some alternative counterpoints
#{level_db=-4}
lydian_c_p_lower_1 =   [F3, E3, D3, D3, D3, C3, A2, A2, C3, D3, E3, F3] | brass_notes(Q);


// Fux's mixolydian first species cantus firmus
#{level_db=-9,skip_slots=2}
fux_mixol_c_f = [G3, C, B3, G3, C, E, D, G, E, C, D, B3, A3, G3] | brass_notes(Q);
#{level_db=-9}
fux_mixol_c_p_upper = [G, E, D, G, G, G, A, B, G, E5, D5, G, F#, G] | brass_notes(Q);
#{level_db=-9}
fux_mixol_c_p_upper_corrected = [G, E, D, G, G, G, A, B, G, C5, A, G, F#, G] | brass_notes(Q);

// Some alternative counterpoints
#{level_db=-9}
mixol_c_p_upper1 = [D, E, D, D, E, C, D, C, C, E, B, G, F#, G] | brass_notes(Q);

#{skip_slots=4, level_db=-9}
morley_c_f =   [C, F, E, D, C, F, G, A, G, E, D, C] | brass_notes(Q);
// This one is pretty boring
#{level_db=-9}
morley_c_p_upper1 = [G, A, G, F, G, A, B, C5, B, C5, B, C5] | brass_notes(Q);
// This c.p. sort of jumps the gun on the c.f.'s high note
#{level_db=-9}
morley_c_p_upper2 = [C5, D5, C5, F, G, A, E5, C5, B, C5, B, C5] | brass_notes(Q);
#{level_db=-9}
morley_c_p_upper2 = [C5, D5, C5, F, G, A, B, C5, E5, C5, B, C5] | brass_notes(Q);


#{level_db=-9,skip_slots=4}
kirnberger_c_f = [C, G, E, A, G, F, E, D, C] | brass_notes(Q);
#{level_db=-9}
kirnberger_c_p_upper1 = [C5, B, B, C5, D5, D5, C5, B, C5] | brass_notes(Q);
#{level_db=-9}
kirnberger_c_p_upper2 = [C5, B, B, C5, D5, A, B, B, C5] | brass_notes(Q);