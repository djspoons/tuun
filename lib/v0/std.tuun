
// MATH

// Define min and max in a waveform-compatible way.
min = fn(x, y) => alt(x - y, y, x);
max = fn(x, y) => alt(x - y, x, y);
abs = fn(x) => alt(x, x, -x);
sign = fn(x) => alt(x, 1, -1);
clamp = fn(x, lower, upper) => min(max(x, lower), upper);
clamp01 = fn(x) => clamp(x, 0, 1);

pi = 3.14159265;
sinh = fn(x) => (exp(x) - exp(-x)) / 2;

// WAVES
// Periodic waveforms should start behave as if they have negative values before the origin 
// and start with their first positive value (including +0.0) at the origin (at least they 
// should when no offset is applied). This will ensure they work well with Reset.

// `sin` is shorthand for sine with no angular frequency.
sin = fn(phase) => sine(0, phase);
// `$` computes a sine wave at the given frequency in hertz (which must be a float or waveform).
$ = fn(freq_hz) => sine(2*pi * freq_hz, 0);
// `sawtooth` computes a sawtooth wave at the given frequency in hertz.
// Note that this is an inverse sawtooth (used so that it meets the
// negative/positive constraint described above).
sawtooth = fn(freq_hz) => (reset($freq_hz, -freq_hz * time) + 0.5) * 2;
// `square` computes a square wave at the given frequency in hertz.
square = fn(freq_hz) => alt($freq_hz, 1, -1);
// `triangle` computes a triangle wave at the given frequency in hertz.
triangle = fn(freq_hz) => let
    t = $freq_hz,
    slope = 4 * freq_hz,
    a = time * slope - 1,
    b = time * -slope + 3
  in alt(t, reset(t, a), reset(t, b));
// Pulse computes a pulse wave with the given width. `width` should be a number (or waveform)
// between 0.0 and 1.0, where 0.0 is a square wave (i.e., 50% duty cycle). If width isn't constant;
// then this is a PWM oscillator.
pulse = fn(width, freq_hz) =>
  let
    // Use a sawtooth wave (which is "lowered" by `width`) as the driver for the pulse.
    s = sawtooth(freq_hz)
  in
    alt(s - width, 1, -1);

// LISTS

len = fn(xs) => reduce(fn(acc, _) => acc + 1, 0, xs);

// Maps a two-argument function over a list of pairs.
map2 = fn(f, xs) => map(fn((a, b)) => f(a, b), xs);

zip = fn(xs, ys) => let
    indexes = unfold(fn(i) => i + 1, 0, len(xs)),
    f = fn(acc, i) => concat([acc, [(nth(i, xs), nth(i, ys))]]),
  in
    reduce(f, [], indexes);

// HELPERS

// Filter which multiplies by the given amplitude
amp = fn(a) => fn(w) => a * w;

// Scale values so that their sum is equal to `target`.
normalize = fn(target) => fn(xs) =>
  let
    sum = reduce(fn(acc, x) => x + acc, 0, xs),
    scale = target / sum,
  in
    map(fn(x) => scale * x, xs);

// Convert db level to amplitude
db2amp = fn(db) => pow(10.0, db / 20.0);

// Returns a linear waveform
// slope is in terms of amplitude-change per second
linear = fn(initial, slope) => initial + (time * slope);
// Convert from MIDI note numbers to frequency
@ = fn(m) => pow(2, (m - 69) / 12) * 440;


over = fn(freq) => fn(x) => $(freq*x) * (1/x); // TODO remove in favor of harmonic?
harmonic = fn(freq) => fn(n) => $(freq*n) * (1/n);

add_semitones = fn(freq, n) => pow(2, n/12) * freq;
add_cents = fn(freq, n) => pow(2, n/1200) * freq;

// Time and Rests
duration_from_beats = fn(beats) => beats * (60 / tempo);

// 4-4 time! (Move to 4-4 file...)
beats_per_measure = 4;
// Note lengths in seconds
W = duration_from_beats(beats_per_measure);
H = W / 2;
Q = W / 4;
E = W / 8;

// Notes as waveforms: use with *
Ww = 1 | fin(time - W) | seq(time - W);
Hw = 1 | fin(time - H) | seq(time - H);
Qw = 1 | fin(time - Q) | seq(time - Q);
Ew = 1 | fin(time - E) | seq(time - E);

// Rests as waveforms: use with <> or \
Wrw = 0 | fin(0) | seq(time - W);
Hrw = 0 | fin(0) | seq(time - H);
Qrw = 0 | fin(0) | seq(time - Q);
Erw = 0 | fin(0) | seq(time - E);

// Some explorations with chords below

// These take the root as a MIDI note number
major_triad = fn(root) => fn(fw) => [fw(@root), fw(@(root + 4)), fw(@(root + 7))];
// major_triad = fn(root, dur, inst) => [inst(dur, @root), inst(dur, @(root + 4)), inst(dur, @(root + 7))];
minor_triad = fn(root) => fn(fw) => [fw(@root), fw(@(root + 3)), fw(@(root + 7))];
// These get a little distorted... may need to scale a bit
// `inst` is an instrument: it takes a duration and a frequency and
// returns a *seq*, so `unseq()` is what turns one note into the
// waveform the chord mixes.
I = fn(key) => fn(inst) => fn(dur) => {map(amp(0.4), major_triad(key)(fn(freq) => inst(dur, freq) | unseq()))} | seq(time - dur);
II = fn(key) => fn(inst) => fn(dur) => {map(amp(0.4), major_triad(key + 2)(fn(freq) => inst(dur, freq) | unseq()))} | seq(time - dur);
III = fn(key) => fn(inst) => fn(dur) => {map(amp(0.4), major_triad(key + 4)(fn(freq) => inst(dur, freq) | unseq()))} | seq(time - dur);
i = fn(key) => fn(inst) => fn(dur) => {map(amp(0.4), minor_triad(key)(fn(freq) => inst(dur, freq) | unseq()))} | seq(time - dur);

// In the key of C
// I = I(60);
// II = II(60);
// III = III(60);
// i = i(60);

// Plays the given waveform `w` on the beats in `bs`, starting at 1. Beats
// should be non-decreasing and `w` should *not* be a sequence-able waveform.
// For example: on_beats(bass(Q) | unseq(), [1, 2, 3, 4])
on_beats = fn(w, bs) => let
    f = fn((current_beat, prev, acc), play_at_beat) =>
        if
          play_at_beat < current_beat
        then
          (play_at_beat, w, acc \ (prev | seq(0)))
        else
          (play_at_beat, w,
            acc \ (prev | seq(time - (duration_from_beats(play_at_beat - current_beat))))),
    (current_beat, prev, acc) = reduce(f, (1, 0 | fin(0), 0 | fin(0) | seq(0)), bs),
  in acc \ prev;
