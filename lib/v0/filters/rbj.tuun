// RBJ Cookbook https://webaudio.github.io/Audio-EQ-Cookbook/Audio-EQ-Cookbook.txt

open std;

lpf = fn(Q, fc) =>
  let
    w0 = 2*pi*fc/sample_rate,
    alpha = sin(w0)/(2*Q),
    b0 = (1 - cos(w0))/2,
    b1 =  1 - cos(w0),
    b2 = (1 - cos(w0))/2,
    a0 =  1 + alpha,
    a1 = -2*cos(w0),
    a2 =  1 - alpha,
  in
    filter([b0/a0, b1/a0, b2/a0], [a1/a0, a2/a0]);

// 24 db low-pass filter, aka 4-pole biquad filter
lpf2 = fn(Q, fc) => fn(w) => w
  | lpf(Q * 0.7654, fc) // sqrt(2) * 0.5412
  | lpf(Q * 1.8478, fc); // sqrt(2) * 1.3065

hpf = fn(Q, fc) =>
  let
    w0 = 2*pi*fc/sample_rate,
    alpha = sin(w0)/(2*Q),
    b0 =  (1 + cos(w0))/2,
    b1 = -(1 + cos(w0)),
    b2 =  (1 + cos(w0))/2,
    a0 =   1 + alpha,
    a1 =  -2*cos(w0),
    a2 =   1 - alpha,
  in
    filter([b0/a0, b1/a0, b2/a0], [a1/a0, a2/a0]);

bpf_const_peak_gain = fn(Q, fc) =>
  let
    w0 = 2*pi*fc/sample_rate,
    alpha = sin(w0)/(2*Q),
    b0 =   alpha,
    b1 =   0,
    b2 =  -alpha,
    a0 =   1 + alpha,
    a1 =  -2*cos(w0),
    a2 =   1 - alpha,
  in
    filter([b0/a0, b1/a0, b2/a0], [a1/a0, a2/a0]);
