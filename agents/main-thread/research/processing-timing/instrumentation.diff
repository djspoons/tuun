index ec97e22..65888da 100644
--- a/src/lib/mod.rs
+++ b/src/lib/mod.rs
@@ -49,3 +49,25 @@ pub mod tracker;
 // WASM module (only compiled when targeting wasm32 or when wasm feature is enabled for testing)
 #[cfg(any(target_arch = "wasm32", feature = "wasm"))]
 pub mod wasm;
+
+/// TEMPORARY timing accumulators (scratch worktree only).
+pub mod prof {
+    use std::cell::RefCell;
+    use std::collections::BTreeMap;
+    thread_local! {
+        static T: RefCell<BTreeMap<&'static str, (f64, f64, u32)>> = RefCell::new(BTreeMap::new());
+    }
+    pub fn add(key: &'static str, start: std::time::Instant) {
+        let ms = start.elapsed().as_secs_f64() * 1000.0;
+        T.with(|t| {
+            let mut t = t.borrow_mut();
+            let e = t.entry(key).or_insert((0.0, 0.0, 0));
+            e.0 += ms;
+            e.1 = e.1.max(ms);
+            e.2 += 1;
+        });
+    }
+    pub fn take() -> BTreeMap<&'static str, (f64, f64, u32)> {
+        T.with(|t| std::mem::take(&mut *t.borrow_mut()))
+    }
+}
